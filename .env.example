# GitHub Copilot Enterprise / GitHub Models API
GITHUB_TOKEN=your_github_pat_here
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
LLM_MODEL_HEAVY=gpt-4o
LLM_MODEL_LIGHT=gpt-4o-mini

# Jira MCP
JIRA_MCP_URL=http://your-jira-mcp-server:8080
JIRA_API_TOKEN=your_jira_api_token
JIRA_BASE_URL=https://your-company.atlassian.net

# qTest MCP
QTEST_MCP_URL=http://your-qtest-mcp-server:8081
QTEST_API_TOKEN=your_qtest_api_token
QTEST_BASE_URL=https://your-company.qtestnet.com

# FA Regression Portal (Internal)
FA_PORTAL_URL=http://fa-regression-portal-internal
FA_PORTAL_TOKEN=your_fa_portal_token

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# File Storage
UPLOADS_DIR=../uploads
TEMPLATES_DIR=../templates

# Database
DB_PATH=../data/qa_workflow.db
